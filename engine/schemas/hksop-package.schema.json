{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HKSOP independent component package",
  "type": "object",
  "required": [
    "format",
    "packageId",
    "records"
  ],
  "properties": {
    "format": {
      "const": "hksop-package-v1"
    },
    "packageId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,199}$"
    },
    "revision": {
      "type": "string"
    },
    "displayName": {
      "type": "string"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "path"
        ],
        "properties": {
          "kind": {
            "enum": [
              "components",
              "kits",
              "registeredBoards"
            ]
          },
          "path": {
            "type": "string"
          },
          "common": {
            "type": "string"
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "target",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "capabilities": {
      "type": "object"
    }
  }
}
